  "components": {
    "securitySchemes": {
      "AdminToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-TraceMason-Token"
      }
    },
    "schemas": {
      "ProviderConfig": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "base_url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "HTTPS or loopback HTTP; no whitespace/userinfo/query/fragment; preserve path and remove trailing slash."
          },
          "api_key_env": {
            "type": "string",
            "description": "Required valid environment variable only in env mode; empty in managed mode."
          },
          "model": {
            "type": "string",
            "description": "Optional test hint only; no model allowlist, no forwarding rewrite."
          },
          "protocol": {
            "type": "string",
            "minLength": 1,
            "description": "Probe preset hint only; not a route or content gate."
          },
          "model_mode": {
            "type": "string",
            "const": "preserve"
          },
          "auth_type": {
            "type": "string",
            "enum": [
              "bearer",
              "x_api_key"
            ]
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "provider_kind": {
            "type": "string",
            "enum": [
              "openai",
              "deepseek",
              "claude",
              "custom"
            ],
            "description": "Provider profile identity; not inferred from URL or model. Many accounts may share a kind."
          },
          "credential_mode": {
            "type": "string",
            "enum": [
              "managed",
              "env"
            ]
          }
        },
        "required": [
          "name",
          "base_url",
          "api_key_env",
          "model",
          "protocol",
          "model_mode",
          "auth_type",
          "provider_kind",
          "credential_mode"
        ],
        "additionalProperties": false
      },
      "Provider": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "base_url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "HTTPS or loopback HTTP; no whitespace/userinfo/query/fragment; preserve path and remove trailing slash."
          },
          "api_key_env": {
            "type": "string",
            "description": "Required valid environment variable only in env mode; empty in managed mode."
          },
          "model": {
            "type": "string",
            "description": "Optional test hint only; no model allowlist, no forwarding rewrite."
          },
          "protocol": {
            "type": "string",
            "minLength": 1,
            "description": "Probe preset hint only; not a route or content gate."
          },
          "model_mode": {
            "type": "string",
            "const": "preserve"
          },
          "configured": {
            "type": "boolean"
          },
          "probe": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Probe"
              },
              {
